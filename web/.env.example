# Config Firebase Web — mismo proyecto que mobile-app (ver mobile-app/.env)
# Fuente de los valores: Firebase Console → Configuración del proyecto → app Web.
#
# Uso local: copiar a .env.local (ver .gitignore) y completar los valores.
#   cp .env.example .env.local

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Pago Azul (Dominican Republic card processor) — sandbox credentials.
# No credentials yet: checkout works with a mocked "success" response until these are set.
# See web/lib/azul/client.ts for where these get consumed.
AZUL_MERCHANT_ID=
AZUL_AUTH_KEY=
AZUL_ENV=sandbox
