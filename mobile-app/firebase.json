{
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": [
    {
      "target": "pay",
      "public": "public-pay",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [
        {
          "source": "/aprobada",
          "function": {
            "functionId": "azulApproved",
            "region": "us-central1"
          }
        },
        {
          "source": "/declinada",
          "function": {
            "functionId": "azulDeclined",
            "region": "us-central1"
          }
        },
        {
          "source": "/cancelada",
          "function": {
            "functionId": "azulCancelled",
            "region": "us-central1"
          }
        },
        {
          "source": "/pay/**",
          "function": {
            "functionId": "payTest",
            "region": "us-central1"
          }
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    }
  ],
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ]
}
