# Fichier modèle — ne contient pas de secrets.
# Usage local : copier vers .env (voir .gitignore) puis renseigner les valeurs
#   cp .env.example .env
# Source des valeurs : Firebase Console → Paramètres du projet → application Web.
#
# Builds EAS (G0-4) : secrets projet, mêmes noms — ne pas mettre de valeurs dans eas.json.
#   eas secret:create --scope project --name EXPO_PUBLIC_FIREBASE_API_KEY --value "<valeur>"
#   eas secret:create --scope project --name EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN --value "<valeur>"
#   eas secret:create --scope project --name EXPO_PUBLIC_FIREBASE_PROJECT_ID --value "<valeur>"
#   eas secret:create --scope project --name EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET --value "<valeur>"
#   eas secret:create --scope project --name EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID --value "<valeur>"
#   eas secret:create --scope project --name EXPO_PUBLIC_FIREBASE_APP_ID --value "<valeur>"
# Vérifier : eas env:list  (ou tableau Secrets sur expo.dev). Doc : https://docs.expo.dev/build-reference/variables/

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
