rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================
    // FONCTIONS UTILITAIRES
    // ==========================================
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function hasRequiredProductFields() {
      return request.resource.data.keys().hasAll(['titulo', 'precio', 'categoria', 'subcategoria', 'condicionGeneral', 'userId', 'createdAt'])
        && request.resource.data.titulo is string
        && request.resource.data.titulo.size() > 0
        && request.resource.data.userId == request.auth.uid;
    }
    
    /** Compteur favoris sur le doc produit (dénormalisé) */
    function prevFavoriteCount() {
      return resource.data.keys().hasAny(['favoriteCount'])
        ? resource.data.favoriteCount
        : 0;
    }
    
    /** Tout utilisateur connecté peut ±1 sur favoriteCount uniquement (titres inchangés) */
    function isFavoriteCountOnlyDelta() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['favoriteCount'])
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.favoriteCount is number
        && request.resource.data.favoriteCount >= 0
        && (
          request.resource.data.favoriteCount == prevFavoriteCount() + 1
          || request.resource.data.favoriteCount == prevFavoriteCount() - 1
        );
    }
    
    function isValidUserUpdate() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdAt', 'email']);
    }

    /** L’utilisateur courant est participant du document conversations/{id} (pour sous-collection messages). */
    function isConversationParticipant(conversationId) {
      return exists(/databases/$(database)/documents/conversations/$(conversationId))
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
    }
    
    // ==========================================
    // COLLECTION: USERS
    // ==========================================
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() 
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['name', 'email', 'createdAt'])
        && request.resource.data.email == request.auth.token.email;
      allow update: if isOwner(userId) && isValidUserUpdate();
      allow delete: if isOwner(userId);
      
      // ==========================================
      // SOUS-COLLECTION: MÉTHODES DE PAIEMENT
      // ==========================================
      match /paymentMethods/{methodId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      // ==========================================
      // SOUS-COLLECTION: ADRESSES DE LIVRAISON
      // ==========================================
      match /addresses/{addressId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.keys().hasAll(['type', 'name', 'recipient', 'phone', 'street', 'sector', 'city', 'province', 'createdAt', 'updatedAt']);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }
      
      // ==========================================
      // SOUS-COLLECTION: WALLET
      // ==========================================
      match /wallet/{walletDoc} {
        allow read: if isOwner(userId);
        // Solo el bootstrap de saldo cero (getWalletData crea el doc la primera vez
        // que se consulta). El balance real nunca lo escribe el cliente — retiros,
        // ventas, recargas: todo eso pasa por Cloud Functions con Admin SDK, que
        // ignora estas reglas. Ver docs/briefing-integration-azul.md §3.4 y el
        // audit de wallet/transactions previo a este cambio (0 saldos distintos de
        // cero, 0 documentos transactions en toda la base).
        allow create: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['userId', 'balance', 'pendingEarnings', 'totalEarnings', 'currency', 'lastUpdated'])
          && request.resource.data.balance == 0
          && request.resource.data.pendingEarnings == 0
          && request.resource.data.totalEarnings == 0;
        allow update, delete: if false;
      }

      // ==========================================
      // SOUS-COLLECTION: TRANSACTIONS
      // ==========================================
      match /transactions/{transactionId} {
        allow read: if isOwner(userId);
        // Igual que wallet: crear una transacción (retiro, venta, recarga) sin
        // pasar por una Cloud Function permitiría fabricar movimientos de dinero
        // ficticios. Únicamente Admin SDK escribe aquí.
        allow create, update, delete: if false;
      }
      
      // ==========================================
      // SOUS-COLLECTION: PRÉFÉRENCES
      // ==========================================
      match /preferences/{prefType} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }
    }
    
    // ==========================================
    // COLLECTION: PRODUCTS
    // ==========================================
    match /products/{productId} {
      allow read: if true;
      allow create: if isAuthenticated() && hasRequiredProductFields();
      allow update: if isAuthenticated()
        && request.resource.data.userId == resource.data.userId
        && (
          resource.data.userId == request.auth.uid
          || isFavoriteCountOnlyDelta()
        );
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // ==========================================
    // COLLECTION: CATEGORIES
    // ==========================================
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if false;
    }
    
    // ==========================================
    // COLLECTION: FAVORITES
    // ==========================================
    match /favorites/{favoriteId} {
      /**
       * `resource == null` : un get()/delete() sur un document inexistant fait que `resource`
       * vaut null — sans ce garde, déréférencer resource.data lève une erreur d'évaluation
       * (remontée côté client comme "permissions insuffisantes" au lieu de "introuvable").
       * Lire/supprimer un document qui n'existe pas est sans risque : ça ne fait rien.
       */
      allow read: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
      /**
       * Création : pas d'exigence sur createdAt (souvent FieldValue.serverTimestamp() :
       * la règle hasAll(['createdAt']) échouait → permission denied sur le batch).
       * L’ID du doc doit être `${uid}_${productId}` pour éviter l’écriture sous un autre ID.
       */
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.userId is string
        && request.resource.data.productId is string
        && request.resource.data.keys().hasAll(['userId', 'productId'])
        && favoriteId == request.auth.uid + '_' + request.resource.data.productId;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
    }
    
    // ==========================================
    // COLLECTION: CONVERSATIONS
    // ==========================================
    match /conversations/{conversationId} {
      /**
       * getDoc si la conversation n’existe pas encore : utiliser exists(chemin) pour autoriser
       * la lecture « vide » sans toucher à resource.data (évite permission denied avant setDoc).
       * || est court-circuité : si le doc n’existe pas, on n’évalue pas participants.
       */
      allow read: if isAuthenticated()
        && (
          !exists(/databases/$(database)/documents/conversations/$(conversationId))
          || request.auth.uid in resource.data.participants
        );
      allow create: if isAuthenticated() 
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2;
      /** S1-1 : empêcher de modifier la liste des participants (exclure l’autre, usurper le fil). */
      allow update: if isAuthenticated()
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants;
      allow delete: if isAuthenticated() 
        && request.auth.uid in resource.data.participants;
      
      match /messages/{messageId} {
        // G0-1 : pas de lecture pour tout utilisateur connecté — uniquement les 2 participants.
        allow read: if isAuthenticated() && isConversationParticipant(conversationId);
        // Pas d’exigence sur createdAt (souvent serverTimestamp() — même problème que favorites).
        allow create: if isAuthenticated()
          && isConversationParticipant(conversationId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.keys().hasAll(['senderId', 'type']);
        allow update: if isAuthenticated()
          && isConversationParticipant(conversationId)
          && resource.data.senderId == request.auth.uid;
        allow delete: if isAuthenticated()
          && isConversationParticipant(conversationId)
          && resource.data.senderId == request.auth.uid;
      }
    }
    
    // ==========================================
    // COLLECTION: REVIEWS
    // ==========================================
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated() 
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll([
          'userId', 'sellerId', 'orderId', 'productId', 'productTitle', 'rating', 'comment', 'createdAt'
        ])
        && request.resource.data.rating >= 1 
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 500;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // ==========================================
    // COLLECTION: ORDERS
    // ==========================================
    match /orders/{orderId} {
      allow read: if isAuthenticated()
        && (resource.data.buyerId == request.auth.uid
            || resource.data.sellerId == request.auth.uid);

      // NOTA: amount sigue siendo escrito por el cliente en la creación — cuando llegue
      // AZUL, este campo debe pasar a ser exclusivo de Cloud Function (briefing §3.4).
      // includeInsurance retirado (opción pagada abandonada, nunca publicada en ninguna
      // política) — ver orderCheckout.ts / BuyScreen.tsx / orderService.ts.
      allow create: if isAuthenticated()
        && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.buyerId != request.resource.data.sellerId
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasAll(['buyerId', 'sellerId', 'productId', 'amount', 'status', 'createdAt'])
        && request.resource.data.keys().hasOnly([
             'buyerId', 'sellerId', 'productId', 'amount', 'status', 'createdAt', 'orderCode',
             'productTitle', 'lineSummary', 'unitCount', 'productImage', 'sellerName', 'sellerAvatar',
             'shippingLabel', 'shippingMethodId', 'deliveryCity', 'deliveryAddressId',
             'deliveryAddressSummary', 'sizeQuantities'
           ]);

      // Cancelación por el comprador — alineado con la política pública
      // (ropanova.com/devoluciones §7: "mientras el pedido no haya sido despachado"),
      // mismo criterio que cancelOrderAsBuyer() en código.
      allow update: if isAuthenticated() && resource.data.buyerId == request.auth.uid
        && resource.data.status in ['pending', 'confirmed']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt'])
        && request.resource.data.status == 'cancelled';

      // El comprador enlaza su reseña — solo si entregada y sin reseña previa.
      allow update: if isAuthenticated() && resource.data.buyerId == request.auth.uid
        && resource.data.status == 'delivered'
        && !resource.data.get('hasReview', false)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reviewId', 'hasReview'])
        && request.resource.data.hasReview == true;

      // Progreso de estado por el vendedor — transiciones explícitas hacia adelante, más
      // cancelación desde cualquier estado previo a 'delivered'. Más estricto que el código
      // actual (updateOrderStatus no valida la transición) — cierra el hueco de saltar
      // directo a 'delivered' o reabrir un pedido cancelado.
      allow update: if isAuthenticated() && resource.data.sellerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'trackingNumber', 'estimatedDelivery'])
        && (
          (resource.data.status == 'pending' && request.resource.data.status == 'confirmed') ||
          (resource.data.status == 'confirmed' && request.resource.data.status == 'shipped') ||
          (resource.data.status == 'shipped' && request.resource.data.status == 'delivered') ||
          (resource.data.status in ['pending', 'confirmed', 'shipped'] && request.resource.data.status == 'cancelled')
        );

      allow delete: if false; // sin caller legítimo encontrado en todo el código
    }
    
    // ==========================================
    // COLLECTION: NOTIFICATIONS
    // ==========================================
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      /** S1-1 : pas de création « pour quelqu’un d’autre » depuis le client (spam / usurpation). Notifier un autre user → Cloud Function (Admin SDK). */
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasAll(['userId'])
        && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // ==========================================
    // COLLECTION: REPORTS
    // ==========================================
    match /reports/{reportId} {
      // Tout utilisateur connecté peut créer un rapport sur un anuncio d'un autre
      allow create: if isAuthenticated()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.keys().hasAll(['productId', 'reporterId', 'reason', 'createdAt']);
      // Lecture/modification réservée aux admins via Admin SDK (Cloud Functions)
      allow read, update, delete: if false;
    }

    // ==========================================
    // COLLECTION: AZUL TRANSACTIONS (fase de prueba técnica — separada
    // de /orders a propósito; ver docs/briefing-integration-azul.md §3.4)
    // ==========================================
    match /azulTransactions/{transactionId} {
      // El cliente solo puede crear el registro inicial de intento de pago, con
      // exactamente estos campos. El monto (amountCents/itbisCents), el estado y
      // todos los campos de respuesta de Azul (authorizationCode, rrn, azulOrderId,
      // isoCode, responseMessage, errorDescription, verifiedAt) los escribe
      // EXCLUSIVAMENTE una Cloud Function vía Admin SDK — nunca el cliente.
      // NOTA — límite conocido de esta regla: solo valida que buyerId sea quien llama,
      // NO que merchantOrderRef pertenezca realmente a ese buyerId (las reglas no tienen
      // de dónde leer esa relación todavía — el modelo de "solicitud de pedido" no está
      // definido). La función que construya el pago con Azul (aún no implementada) DEBE
      // verificar la pertenencia de merchantOrderRef al buyerId autenticado antes de
      // generar el AuthHash; no confiar en esta regla para eso.
      allow create: if isAuthenticated()
        && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.keys().hasOnly(['orderNumber', 'merchantOrderRef', 'buyerId', 'createdAt'])
        && request.resource.data.orderNumber is string
        && request.resource.data.orderNumber.size() > 0
        && request.resource.data.merchantOrderRef is string
        && request.resource.data.merchantOrderRef.size() > 0;
      // El comprador puede consultar el estado de su propia transacción (polling).
      allow read: if isAuthenticated() && resource.data.buyerId == request.auth.uid;
      // Toda actualización (monto, estado, campos de respuesta Azul) pasa por
      // Cloud Functions con Admin SDK, que ignora estas reglas.
      allow update, delete: if false;
    }

    // ==========================================
    // COLLECTION: FOLLOWS (seguimiento de tiendas)
    // ==========================================
    match /follows/{followId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.followerId == request.auth.uid);
      allow create: if isAuthenticated()
        && request.resource.data.followerId == request.auth.uid
        && request.resource.data.keys().hasAll(['followerId', 'storeId', 'createdAt'])
        && followId == request.auth.uid + '_' + request.resource.data.storeId;
      allow delete: if isAuthenticated() && (resource == null || resource.data.followerId == request.auth.uid);
    }

    // ==========================================
    // BLOQUER TOUTE AUTRE COLLECTION
    // ==========================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
